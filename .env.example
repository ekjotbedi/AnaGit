# ─────────────────────────────────────────────────────────────
#  AnaGit — environment variables
#  Copy this file to ".env" and fill in the real values.
# ─────────────────────────────────────────────────────────────

# server
# One server serves both the dashboard (/) and the API (/api/*),
# so this is the ONLY port and the ONLY URL needed
PORT=4000
NODE_ENV=development

# database
# Option A) MongoDB Atlas (free cloud tier — no install):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/anagit
# Option B) Local MongoDB / Docker:
#   mongodb://127.0.0.1:27017/anagit
MONGODB_URI=mongodb://127.0.0.1:27017/anagit

# sessions
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# token encryption (encrypts GitHub access tokens at rest)
# Must be 64 hex characters (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth App
# Create one at: https://github.com/settings/developers  → "New OAuth App"
#   Homepage URL:               http://localhost:4000
#   Authorization callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Scopes: "repo" allows reading private repos too
GITHUB_OAUTH_SCOPES=read:user,repo

# webhooks
# The secret you enter when creating a webhook on a GitHub repo. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GITHUB_WEBHOOK_SECRET=change-me-to-a-webhook-secret

# Tuning
# How long (seconds) a cached GitHub response is considered "fresh".
CACHE_TTL_SECONDS=300
# Max pages to walk when paginating a single GitHub list (safety cap).
MAX_PAGES=10
# Max time (ms) we'll pause to wait out a primary rate limit before giving up.
MAX_RATE_LIMIT_WAIT_MS=60000
# Cron schedule for the automatic background re-sync of all repos.
# Default: every 5 hours. (Standard 5-field cron syntax.)
SYNC_CRON=0 */5 * * *
# An open issue is "stale" if it hasn't been updated in these many days.
STALE_ISSUE_DAYS=30
